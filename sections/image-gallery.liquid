{% stylesheet %}
.image-slider-wrapper {
  overflow-x: auto;
  scroll-behavior: smooth;
}
.image-slider {
   display: flex;
  gap: 1rem;
  transition: transform 0.5s ease;
  min-width: 100%;
}
.image-slide {
  flex: 0 0 calc(100% / var(--slides-per-view));
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
}
.image-slide img {
  width: 100%;
  height: 100%;
  object-fit: var(--object-fit);
  border-radius: 8px;
}
.image-slide .caption {
  position: absolute;
  bottom: 10px;
  left: 10px;
  background: rgba(0,0,0,0.5);
  color: white;
  padding: 0.5rem;
  font-size: 0.9rem;
}
  .image-slider-section {
  padding-top: var(--padding-top);
  padding-bottom: var(--padding-bottom);
}
  @media (max-width: 767px) {
  .image-slide {
    flex: 0 0 calc(100% / var(--slides-per-view-mobile));
  }
}
{% endstylesheet %}

<div 
  class="image-slider-section page-width" 
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; padding-top: var(--padding-top); padding-bottom: var(--padding-bottom);"
>
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  {%- assign fit = section.settings.image_ratio -%}
  {%- if fit == 'adapt' -%}
    {%- assign fit = 'cover' -%}
  {%- endif -%}

  <div 
  class="image-slider-wrapper" 
  style="--slides-per-view: {{ section.settings.images_per_row }}; --slides-per-view-mobile: {{ section.settings.images_per_row_mobile }}; --object-fit: {{ fit }};">

    <div class="image-slider" id="image-slider-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="image-slide">
            <img 
              src="{{ block.settings.image | image_url: width: 900 }}" 
              alt="{{ block.settings.caption | escape }}" 
              loading="lazy">
            {% if block.settings.caption != blank %}
              <div class="caption">{{ block.settings.caption }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image Slider"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover (Crop to fit)"
        },
        {
          "value": "contain",
          "label": "Contain (Fit inside)"
        },
        {
          "value": "fill",
          "label": "Stretch (Not recommended)"
        }
      ]
    },
    {
  "type": "range",
  "id": "padding_top",
  "label": "Top Padding (px)",
  "min": 0,
  "max": 100,
  "step": 4,
  "default": 32
},
{
  "type": "range",
  "id": "padding_bottom",
  "label": "Bottom Padding (px)",
  "min": 0,
  "max": 100,
  "step": 4,
  "default": 32
},

    {
      "type": "range",
      "id": "images_per_row",
      "label": "Images per row (desktop)",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
  "type": "range",
  "id": "images_per_row_mobile",
  "label": "Images per row (mobile)",
  "min": 1,
  "max": 3,
  "step": 1,
  "default": 1
  },

  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Image caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Slider",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
