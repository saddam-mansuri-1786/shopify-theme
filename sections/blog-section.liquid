{% stylesheet %}
.custom-blog-section {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 2rem;
  padding: 3rem 1rem;
  max-width: var(--page-width, 1200px);
  margin: 0 auto;
}

.custom-blog-text {
  flex: 1 1 45%;
  text-align: center;
}

.custom-blog-images {
  flex: 1 1 45%;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.custom-blog-images .big-image {
  width: 100%;
  max-width: 500px;
  border-radius: 8px;
}

.custom-blog-images .small-image {
     position: absolute;
    bottom: -10%;
    top: auto;
    right: 0px;
    width: 35%;
    border-radius: 4px;
    box-shadow: 0 0 10px #0003;
    z-index: 2;
}

@media (max-width: 1024px) {
  .custom-blog-section {
    flex-direction: column;
    padding: 2rem 1rem;
  }
  .custom-blog-images {
    flex-direction: column;
    align-items: center;
  }
  .custom-blog-images .small-image {
    position: relative;
    top: auto;
    right: auto;
    margin-top: 1rem;
  }
}
{% endstylesheet %}

<div class="custom-blog-section {% if section.settings.reverse_layout %}flex-row-reverse{% endif %}">
  <div class="custom-blog-images">
    {% if section.settings.big_image != blank %}
      <img src="{{ section.settings.big_image | image_url: width: 800 }}" alt="Big image" class="big-image">
    {% endif %}
    {% if section.settings.small_image != blank %}
      <img src="{{ section.settings.small_image | image_url: width: 300 }}" alt="Small image" class="small-image">
    {% endif %}
  </div>
  <div class="custom-blog-text">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Blog Highlight",
  "settings": [
    {
      "type": "image_picker",
      "id": "big_image",
      "label": "Big Image"
    },
    {
      "type": "image_picker",
      "id": "small_image",
      "label": "Small Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "REVERED BLOG"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Content",
      "default": "From the iconic and award-winning studio, read all about it."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "All Posts"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse Layout (Text First)",
      "default": false
    },
    {
  "type": "range",
  "id": "padding_top",
  "label": "Top Padding (px)",
  "min": 0,
  "max": 100,
  "step": 4,
  "default": 32
},
{
  "type": "range",
  "id": "padding_bottom",
  "label": "Bottom Padding (px)",
  "min": 0,
  "max": 100,
  "step": 4,
  "default": 32
}
  ],
  "presets": [
    {
      "name": "Blog Highlight",
      "category": "Custom"
    }
  ]
}
{% endschema %}
