{% schema %}
{
  "name": "Contact Custom Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "If you have any questions, feel free to reach out via the form or the information below."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(123) 456-7890"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "support@example.com"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business Hours",
      "default": "Mon - Fri: 9AM - 5PM EST"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "641 Farmington Ave,Hartford,Connecticut 06105"
    },
    {
      "type": "textarea",
      "id": "google_map_embed",
      "label": "Google Map Embed Code",
      "default": "<iframe src='https://maps.google.com/...your-map-link...' width='100%' height='300' style='border:0;' allowfullscreen='' loading='lazy'></iframe>"
    }
  ],
  "presets": [
    {
      "name": "Contact Custom Section"
    }
  ]
}
{% endschema %}

<style>
  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 40px 20px;
    max-width: 1050px;
    margin: 0 auto;
  }

  .contact-left h1 {
    font-size: 2rem;
    margin-bottom: 10px;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 10px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
  }

  .contact-form button {
    background-color: black;
    color: white;
    padding: 10px 25px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .contact-form button:hover {
    background-color: #444;
  }

  .map-container {
    max-width: 850px;
    margin: 40px auto 0;
    padding: 0 0 40px 0;
  }

  /* Make Google Map iframe responsive */
  .map-container iframe {
    width: 100% !important;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  /* Responsive layout for tablets and mobile */
  @media (max-width: 768px) {
    .contact-container {
      grid-template-columns: 1fr;
      padding: 20px 15px;
    }

    .contact-left, .contact-form {
      width: 100%;
    }
    
    .contact-left h1 {
      font-size: 1.5rem;
    }

    .map-container {
      padding: 0 15px;
    }
  }
</style>


<div class="contact-container">
  <div class="contact-left">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.description }}</p>
    <br>
    <p><strong></strong> {{ section.settings.phone }}</p>
    <p><strong></strong> {{ section.settings.email }}</p>
    <p><strong></strong> {{ section.settings.hours }}</p>
    <p><strong></strong> {{ section.settings.address }}</p>
  </div>

  <div class="contact-form">
    {% form 'contact' %}
      <input type="text" name="contact[name]" placeholder="Name" required>
      <input type="email" name="contact[email]" placeholder="Email" required>
      <input type="tel" name="contact[phone]" placeholder="Phone Number">
      <textarea name="contact[body]" rows="6" placeholder="Message" required></textarea>
      <button type="submit">Send Message</button>
    {% endform %}
  </div>
</div>

<div class="map-container">
  {{ section.settings.google_map_embed }}
</div>
