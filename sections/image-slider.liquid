{% stylesheet %}
.image-slider-wrapper {
  overflow: hidden;
}
.image-slider {
  display: flex;
  gap: 1rem;
  transition: transform 0.5s ease;
}
.image-slide {
  flex: 0 0 calc(100% / var(--slides-per-view));
  position: relative;
}
.image-slide img {
  width: 100%;
  height: auto;
  object-fit: var(--object-fit);
  border-radius: 8px;
}
.image-slide .caption {
  position: absolute;
  bottom: 10px;
  left: 10px;
  background: rgba(0,0,0,0.5);
  color: white;
  padding: 0.5rem;
  font-size: 0.9rem;
}
  .image-slider-section {
  padding-top: var(--padding-top);
  padding-bottom: var(--padding-bottom);
}
{% endstylesheet %}

<div 
  class="image-slider-section page-width" 
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; padding-top: var(--padding-top); padding-bottom: var(--padding-bottom);"
>
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}

  <div 
    class="image-slider-wrapper" 
    {%- assign fit = section.settings.image_ratio -%}
{%- if fit == 'adapt' -%}
  {%- assign fit = 'cover' -%}
{%- endif -%}

<div 
  class="image-slider-wrapper" 
  style="--slides-per-view: {{ section.settings.images_per_row }}; --object-fit: {{ fit }};">

    <div class="image-slider" id="image-slider-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="image-slide">
            <img 
              src="{{ block.settings.image | image_url: width: 900 }}" 
              alt="{{ block.settings.caption | escape }}" 
              loading="lazy">
            {% if block.settings.caption != blank %}
              <div class="caption">{{ block.settings.caption }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% javascript %}
  {% if section.settings.autoplay %}
    const slider = document.querySelector('#image-slider-{{ section.id }}');
    let scrollAmount = 0;
    const slide = slider.querySelector('.image-slide');
    const slideWidth = slide ? slide.offsetWidth + 16 : 300; // include gap

    setInterval(() => {
      scrollAmount += slideWidth;
      if (scrollAmount >= slider.scrollWidth - slider.clientWidth) {
        scrollAmount = 0;
      }
      slider.scrollTo({ left: scrollAmount, behavior: 'smooth' });
    }, {{ section.settings.autoplay_speed }});
  {% endif %}
{% endjavascript %}

{% schema %}
{
  "name": "Image Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image Slider"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover (Crop to fit)"
        },
        {
          "value": "contain",
          "label": "Contain (Fit inside)"
        },
        {
          "value": "fill",
          "label": "Stretch (Not recommended)"
        }
      ]
    },
    {
  "type": "range",
  "id": "padding_top",
  "label": "Top Padding (px)",
  "min": 0,
  "max": 100,
  "step": 4,
  "default": 32
},
{
  "type": "range",
  "id": "padding_bottom",
  "label": "Bottom Padding (px)",
  "min": 0,
  "max": 100,
  "step": 4,
  "default": 32
},

    {
      "type": "range",
      "id": "images_per_row",
      "label": "Images per row (desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (ms)",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "default": 3000
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Image caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Slider",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
